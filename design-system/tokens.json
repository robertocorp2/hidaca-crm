{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "HIDACA Operaciones design tokens",
  "version": "1.0.0",
  "source": "hidaca-constructora-app/app/globals.css",
  "notes": "Normalized from the existing HIDACA private operations app. Values preserve the established green, gold, compact CRM visual language.",
  "color": {
    "brand": {
      "forest": {
        "value": "#052e21",
        "role": "Deepest navigation and login background"
      },
      "deep": { "value": "#073d2b", "role": "Brand dark surface" },
      "primary": { "value": "#0c6747", "role": "Primary action and active UI" },
      "primaryHover": { "value": "#0a5139", "role": "Primary action hover" },
      "tint": { "value": "#e8f3ed", "role": "Soft brand tint" },
      "gold": {
        "value": "#c5a44d",
        "role": "Accent, active navigation rail, selected mark"
      },
      "goldLight": { "value": "#ead9a5", "role": "Accent on dark surfaces" }
    },
    "background": {
      "canvas": { "value": "#f3f6f4", "role": "Application page background" },
      "surface": { "value": "#ffffff", "role": "Cards, panels, inputs" },
      "surfaceSubtle": { "value": "#f7fbf8", "role": "Quiet inset surface" },
      "surfaceBrand": {
        "value": "#eaf2ee",
        "role": "Icon and metric background"
      }
    },
    "text": {
      "primary": { "value": "#183029", "role": "Default content" },
      "heading": { "value": "#052e21", "role": "Headings and strong emphasis" },
      "secondary": {
        "value": "#667970",
        "role": "Supporting copy and metadata"
      },
      "onBrand": { "value": "#ffffff", "role": "Text on dark brand surfaces" },
      "onAccent": {
        "value": "#745917",
        "role": "Text on warning/gold surfaces"
      }
    },
    "border": {
      "default": { "value": "#dce5e0", "role": "Default separation" },
      "strong": { "value": "#c9ded2", "role": "Control and panel emphasis" },
      "focus": {
        "value": "rgba(12, 103, 71, 0.34)",
        "role": "Keyboard focus ring"
      }
    },
    "action": {
      "primary": { "value": "#0c6747", "role": "Primary action" },
      "primaryHover": { "value": "#0a5139", "role": "Primary action hover" },
      "secondaryText": { "value": "#0a5139", "role": "Secondary action text" },
      "danger": { "value": "#a13636", "role": "Destructive action" }
    },
    "status": {
      "success": { "value": "#2f7d55", "role": "Completed, connected, paid" },
      "warning": { "value": "#9a741d", "role": "Pending, review, caution" },
      "danger": { "value": "#a13636", "role": "Failed, overdue, destructive" },
      "info": { "value": "#294f8a", "role": "Informational activity state" },
      "neutral": { "value": "#667970", "role": "Unknown or neutral state" }
    }
  },
  "space": {
    "2xs": { "value": "4px", "role": "Icon-to-label and micro gaps" },
    "xs": { "value": "8px", "role": "Compact control gap" },
    "sm": { "value": "12px", "role": "Tight content grouping" },
    "md": { "value": "16px", "role": "Default component gap" },
    "lg": { "value": "24px", "role": "Panel padding and section gap" },
    "xl": { "value": "32px", "role": "Large component separation" },
    "2xl": { "value": "40px", "role": "Page inset" },
    "3xl": { "value": "48px", "role": "Large page separation" },
    "4xl": { "value": "64px", "role": "Hero-scale separation" }
  },
  "typography": {
    "fontFamily": {
      "value": "Inter, Segoe UI, Arial, sans-serif",
      "role": "Default UI family"
    },
    "size": {
      "xs": { "value": "12px", "role": "Labels, table headers, metadata" },
      "sm": { "value": "14px", "role": "Secondary copy and compact UI" },
      "md": { "value": "16px", "role": "Default body copy" },
      "lg": { "value": "18px", "role": "Panel headings" },
      "xl": { "value": "24px", "role": "Section headings" },
      "2xl": { "value": "32px", "role": "Page headings" },
      "display": {
        "value": "clamp(2.2rem, 4.4vw, 3.25rem)",
        "role": "High-priority page title"
      }
    },
    "weight": {
      "regular": { "value": "400", "role": "Body" },
      "medium": { "value": "600", "role": "Control labels" },
      "bold": { "value": "750", "role": "Headings and actions" },
      "heavy": { "value": "850", "role": "Eyebrows and navigation labels" }
    },
    "lineHeight": {
      "tight": { "value": "1.1", "role": "Large headings" },
      "body": { "value": "1.55", "role": "Body and form guidance" },
      "comfortable": { "value": "1.65", "role": "Long-form copy" }
    }
  },
  "radius": {
    "sm": { "value": "8px", "role": "Controls, chips, small cards" },
    "md": { "value": "10px", "role": "Inputs and compact panels" },
    "lg": { "value": "12px", "role": "Cards and dialogs" },
    "xl": { "value": "14px", "role": "Primary workspace panels" },
    "pill": { "value": "999px", "role": "Status badges and chips" }
  },
  "shadow": {
    "xs": {
      "value": "0 4px 16px rgba(6, 49, 34, 0.045)",
      "role": "Subtle raised control"
    },
    "sm": {
      "value": "0 10px 28px rgba(6, 49, 34, 0.05)",
      "role": "Panel elevation"
    },
    "md": {
      "value": "0 16px 48px rgba(6, 49, 34, 0.08)",
      "role": "Workspace elevation"
    },
    "overlay": {
      "value": "0 18px 48px rgba(6, 49, 34, 0.16)",
      "role": "Dropdown and popover"
    }
  },
  "breakpoint": {
    "mobile": { "value": "600px", "role": "Collapse topbar and KPI grid" },
    "compact": {
      "value": "760px",
      "role": "Mobile navigation and stacked layouts"
    },
    "tablet": { "value": "1100px", "role": "Collapse sidebar to drawer" },
    "wide": { "value": "1500px", "role": "Workspace max-width" },
    "ultraWide": { "value": "1760px", "role": "Six-column dashboard threshold" }
  },
  "motion": {
    "fast": { "value": "140ms", "role": "Hover and row feedback" },
    "normal": { "value": "180ms", "role": "Drawer and menu transitions" },
    "easing": { "value": "ease", "role": "Default transition easing" },
    "reducedMotion": {
      "value": "prefers-reduced-motion: reduce",
      "role": "Disable non-essential motion"
    }
  },
  "zIndex": {
    "sticky": { "value": "20", "role": "Topbar" },
    "drawer": { "value": "50", "role": "Mobile navigation" },
    "backdrop": { "value": "40", "role": "Drawer backdrop" },
    "popover": { "value": "80", "role": "Search and profile popovers" },
    "modal": { "value": "100", "role": "Modal and dialog surfaces" },
    "skipLink": { "value": "200", "role": "Accessibility skip link" }
  }
}
